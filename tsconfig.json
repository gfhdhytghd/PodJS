{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@pocketjs/framework/solid": ["./vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/components": ["./vendor/pocketjs/framework/src/components.ts"],
      "solid-js/jsx-runtime": ["./packages/framework/node_modules/solid-js/jsx-runtime.d.ts"],
      "@podjs/companion/*": [
        "./platforms/harmony/companion/*"
      ]
    },
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "packages/cli/templates/**"
  ]
}
