    "CREATE INDEX IF NOT EXISTS `index_sync_change_log_seq` ON `sync_change_log` (`seq`)",
    "CREATE TABLE IF NOT EXISTS `sync_peer_state` (`peerDeviceId` TEXT NOT NULL, `lastLocalSeqAckedByPeer` INTEGER NOT NULL, `lastRemoteSeqApplied` INTEGER NOT NULL, `lastFullSyncAt` INTEGER NOT NULL, `lastProtocolVersion` INTEGER NOT NULL, `updatedAt` INTEGER NOT NULL, PRIMARY KEY(`peerDeviceId`))",
