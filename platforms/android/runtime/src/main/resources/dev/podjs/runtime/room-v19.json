    "CREATE TABLE IF NOT EXISTS `saved_entries` (`id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, `itemId` INTEGER NOT NULL, `saveType` TEXT NOT NULL, `createdAt` INTEGER NOT NULL, `sortOrder` INTEGER NOT NULL, FOREIGN KEY(`itemId`) REFERENCES `rss_items`(`id`) ON UPDATE NO ACTION ON DELETE CASCADE )",
    "CREATE INDEX IF NOT EXISTS `index_saved_entries_itemId` ON `saved_entries` (`itemId`)",
