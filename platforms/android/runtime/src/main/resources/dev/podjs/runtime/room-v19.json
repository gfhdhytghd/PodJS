    "CREATE TABLE IF NOT EXISTS `saved_sync_states` (`articleId` TEXT NOT NULL, `saveType` TEXT NOT NULL, `itemId` INTEGER, `url` TEXT NOT NULL, `saved` INTEGER NOT NULL, `changedAt` INTEGER NOT NULL, `sortOrder` INTEGER NOT NULL, `sourceDeviceId` TEXT NOT NULL, PRIMARY KEY(`articleId`, `saveType`))",
